[submodule "GLFW"]
	path = vendor/GLFW
	url = https://github.com/glfw/glfw.git
[submodule "Glad"]
	path = vendor/Glad
	url = https://github.com/XakNitram/Glad.git
[submodule "vendor/glm"]
	path = vendor/glm
	url = https://github.com/g-truc/glm.git
[submodule "ext/entt"]
	path = ext/entt
	url = https://github.com/skypjack/entt.git
[submodule "ext/glfw"]
	path = ext/glfw
	url = https://github.com/glfw/glfw.git
[submodule "ext/glad"]
	path = ext/glad
	url = https://github.com/tmioton/Glad.git
[submodule "ext/glm"]
	path = ext/glm
	url = https://github.com/g-truc/glm.git
